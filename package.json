{
  "private": true,
  "scripts": {
    "test": "pnpm -r test",
    "release": "bumpp",
    "lint": "oxlint --fix",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "bumpp": "^11.0.1",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "lint-staged": "^6.1.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "yorkie": "^1.0.3"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.js": [
      "oxlint --fix",
      "git add"
    ]
  },
  "packageManager": "pnpm@10.4.1",
  "gitHooks": {
    "pre-commit": "lint-staged"
  }
}
