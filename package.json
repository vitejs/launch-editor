{
  "private": true,
  "scripts": {
    "test": "pnpm -r test",
    "release": "bumpp",
    "lint": "oxlint --fix",
    "format": "oxfmt"
  },
  "devDependencies": {
    "bumpp": "^11.1.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "yorkie": "^2.0.0"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.js": [
      "oxlint --fix"
    ]
  },
  "packageManager": "pnpm@10.34.9",
  "gitHooks": {
    "pre-commit": "lint-staged"
  }
}
